[Unit]
Description=MiniX drive/video/ADAS web server
After=network.target dev-ttyUSB0.device

[Service]
Type=simple
User=sreekumar
WorkingDirectory=/home/sreekumar/minix/jetson
ExecStart=/home/sreekumar/minix-detect/bin/python /home/sreekumar/minix/jetson/app.py
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
